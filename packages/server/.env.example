# Songgest Server Environment Configuration
# Copy this file to .env inside packages/server/

# Database connection URL relative to packages/server
DATABASE_URL="file:./prisma/dev.db"

# Server runtime port
PORT=3001

# Node runtime environment
NODE_ENV=development

# Allowed CORS origins
CORS_ORIGIN="http://localhost:5173"

# Spotify Web API Credentials (Optional)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3001/api/spotify/callback"
