# Songgest Environment Configuration
# Copy this file to .env and adjust variables as needed

DATABASE_URL="file:./packages/server/prisma/dev.db"
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Music Metadata Provider for Quick Play ('local-fixtures' or 'deezer')
# Default is 'local-fixtures' for offline development and testing.
# Set to 'deezer' to retrieve real song metadata from the official Deezer public REST API.
MUSIC_METADATA_PROVIDER="local-fixtures"

# Spotify Web API Credentials (Optional, for Custom Playlist import)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3001/api/spotify/callback"
