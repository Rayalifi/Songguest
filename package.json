{
  "name": "songgest",
  "version": "0.1.0",
  "private": true,
  "description": "Songgest: Modern music recognition game with micro-duration snippets",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "dev": "npm run dev --workspace=packages/client",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:client": "npm run dev --workspace=packages/client",
    "smoke": "npm run smoke --workspace=@songgest/server"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
